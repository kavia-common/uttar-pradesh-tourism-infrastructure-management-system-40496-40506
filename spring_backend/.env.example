# Backend environment variables (sample). Do NOT commit real secrets.

SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5001/myapp
SPRING_DATASOURCE_USERNAME=appuser
SPRING_DATASOURCE_PASSWORD=replace-with-secure-password

SPRING_JPA_HIBERNATE_DDL_AUTO=validate

APP_JWT_SECRET=replace-with-strong-secret-or-base64
APP_JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGIN=http://localhost:3000

APP_UPLOAD_DIR=uploads
